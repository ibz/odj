# Maintainer: ibz <github@ibz.me>
pkgname=odj-git
_pkgname=odj
pkgver=r1.a9b6d61
pkgrel=1
pkgdesc="Keyboard-driven DJ player for the terminal, inspired by the Pioneer CDJ-800"
arch=('x86_64' 'aarch64')
url="https://github.com/ibz/odj"
license=('MIT')
depends=('rubberband' 'alsa-lib' 'gcc-libs' 'glibc')
makedepends=('cargo' 'git')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  if git describe --long --tags >/dev/null 2>&1; then
    git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/odj "$pkgdir/usr/bin/odj"
  install -Dm644 packaging/odj.desktop "$pkgdir/usr/share/applications/odj.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
