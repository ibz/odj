# Maintainer: ibz <github@ibz.me>
pkgname=odj-git
_pkgname=odj
pkgver=r54.a904a23
pkgrel=1
pkgdesc="Keyboard-driven DJ player (inspired by Pioneer CDJ decks), track downloader, sampler and input mixer for the terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/ibz/odj"
license=('MIT')
depends=('rubberband' 'alsa-lib' 'libpipewire' 'gcc-libs' 'glibc' 'yt-dlp' 'tmux')
makedepends=('cargo' 'clang' 'git')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!lto')
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  if git describe --long --tags >/dev/null 2>&1; then
    git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --workspace
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/odj-player "$pkgdir/usr/bin/odj-player"
  install -Dm755 target/release/odj-sampler "$pkgdir/usr/bin/odj-sampler"
  install -Dm755 target/release/odj-downloader "$pkgdir/usr/bin/odj-downloader"
  install -Dm755 target/release/odj-mixer "$pkgdir/usr/bin/odj-mixer"
  install -Dm755 odj.sh "$pkgdir/usr/bin/odj.sh"
  ln -s odj.sh "$pkgdir/usr/bin/odj"
  install -Dm644 packaging/odj-player.desktop "$pkgdir/usr/share/applications/odj-player.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
